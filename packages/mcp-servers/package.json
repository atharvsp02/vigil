{
  "name": "@vigil/mcp-servers",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start:observability": "node dist/observability/index.js",
    "start:deploys": "node dist/deploys/index.js",
    "dev:observability": "tsx watch src/observability/index.ts",
    "dev:deploys": "tsx watch src/deploys/index.ts",
    "pretypecheck": "pnpm --filter @vigil/checkout-client build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "pretest": "pnpm --filter @vigil/checkout-client build",
    "test": "vitest run"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@vigil/checkout-client": "workspace:*",
    "express": "^4.21.2",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
