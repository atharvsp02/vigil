# scripts/dev.sh generates any missing token below into .env on first run,
# so copying this file is optional.

# Shared secret between the checkout service and the deploys MCP server.
ADMIN_TOKEN=

# Shared secret the harness presents to both MCP servers.
MCP_BEARER_TOKEN=

# Scoped credential that allows reading replay bundles without deploy rights.
REPLAY_TOKEN=

# Bearer token the dashboard server presents to the Vigil backend.
VIGIL_API_TOKEN=
